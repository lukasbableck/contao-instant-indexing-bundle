{
	"name": "lukasbableck/contao-instant-indexing-bundle",
	"type": "contao-bundle",
	"description": "This bundle sends a crawl request to the Google Indexing API for newly published pages, news, etc.",
	"keywords": [
		"google",
		"search console",
		"seo",
		"indexing",
		"publish",
		"crawl"
	],
	"license": "LGPL-3.0-or-later",
	"authors": [
		{
			"name": "Lukas Bableck",
			"email": "lukas@bableck.dev",
			"homepage": "https://bableck.dev"
		}
	],
	"require": {
		"php": "^8.1",
		"contao/core-bundle": "^5.3 || ^6.0",
		"google/apiclient": "^2.15",
		"guzzlehttp/guzzle": "^7.15",
		"monolog/monolog": "^2.0 || ^3.0",
		"psr/log": "^1.1 || ^2.0 || ^3.0",
		"symfony/config": "^6.4 || ^7.4 || ^8.1",
		"symfony/dependency-injection": "^6.4 || ^7.4 || ^8.1",
		"symfony/event-dispatcher": "^6.4 || ^7.4 || ^8.1",
		"symfony/http-foundation": "^6.4 || ^7.4 || ^8.1",
		"symfony/http-kernel": "^6.4 || ^7.4 || ^8.1",
		"symfony/routing": "^6.4 || ^7.4 || ^8.1",
		"symfony/translation-contracts": "^3.0"
	},
	"suggest": {
		"contao/calendar-bundle": "Automatically index newly published calendar events",
		"contao/faq-bundle": "Automatically index newly published FAQ entries",
		"contao/news-bundle": "Automatically index newly published news articles"
	},
	"conflict": {
		"contao/manager-plugin": "<2.0 || >=3.0"
	},
	"require-dev": {
		"contao/manager-plugin": "^2.0",
		"contao/calendar-bundle": "^5.3 || ^6.0",
		"contao/faq-bundle": "^5.3 || ^6.0",
		"contao/news-bundle": "^5.3 || ^6.0"
	},
	"autoload": {
		"psr-4": {
			"Lukasbableck\\ContaoInstantIndexingBundle\\": "src/"
		}
	},
	"extra": {
		"contao-manager-plugin": "Lukasbableck\\ContaoInstantIndexingBundle\\ContaoManager\\Plugin"
	}
}
